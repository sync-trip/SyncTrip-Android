<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- 남은 장소 수 -->
    <TextView
        android:id="@+id/tvVoteCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="남은 장소: 5개"
        android:textSize="14sp"
        android:textColor="#888888"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 장소 카드 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardVote"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvVoteCount"
        app:layout_constraintBottom_toTopOf="@id/btnDislike"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 장소 이미지 -->
            <ImageView
                android:id="@+id/ivPlaceImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery" />

            <!-- 어두운 오버레이 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#80000000" />

            <!-- 장소 정보 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_gravity="bottom"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- 카테고리 -->
                <TextView
                    android:id="@+id/tvVoteCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="문화"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:background="#664CAF50"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp" />

                <!-- 장소명 -->
                <TextView
                    android:id="@+id/tvVotePlaceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="경복궁"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <!-- 평점 -->
                <TextView
                    android:id="@+id/tvVoteRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ 4.5"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <!-- 싫어요 버튼 -->
    <Button
        android:id="@+id/btnDislike"
        android:layout_width="120dp"
        android:layout_height="56dp"
        android:text="❌ 싫어요"
        android:backgroundTint="#FF5722"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnLike" />

    <!-- 좋아요 버튼 -->
    <Button
        android:id="@+id/btnLike"
        android:layout_width="120dp"
        android:layout_height="56dp"
        android:text="👍 좋아요"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnDislike"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>