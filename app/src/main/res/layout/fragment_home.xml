<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- 여행 제목 -->
        <TextView
            android:id="@+id/tvTripTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏖️ 제주도 여행"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 여행 날짜 -->
        <TextView
            android:id="@+id/tvTripDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 2026.05.01 ~ 05.03 (3일)"
            android:textSize="14sp"
            android:textColor="#888888"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvTripTitle"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 멤버 수 -->
        <TextView
            android:id="@+id/tvMemberCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👥 멤버 4명"
            android:textSize="14sp"
            android:textColor="#888888"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvTripDate"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 초대 코드 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardInviteCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/tvMemberCount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="초대 코드"
                    android:textSize="14sp"
                    android:textColor="#888888" />

                <!-- 초대 코드 -->
                <TextView
                    android:id="@+id/tvInviteCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ABC123"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="#4CAF50" />

                <!-- 복사 버튼 -->
                <Button
                    android:id="@+id/btnCopyCode"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="복사"
                    android:textSize="12sp"
                    android:backgroundTint="#4CAF50" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 구분선 -->
        <View
            android:id="@+id/divider1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/cardInviteCode" />

        <!-- 장소 담기 버튼 -->
        <Button
            android:id="@+id/btnAddPlace"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            android:text="📍 장소 담기"
            android:backgroundTint="#4CAF50"
            app:layout_constraintTop_toBottomOf="@id/divider1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnStartVote" />

        <!-- 투표 시작 버튼 -->
        <Button
            android:id="@+id/btnStartVote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🗳️ 투표 시작"
            android:backgroundTint="#2196F3"
            app:layout_constraintTop_toBottomOf="@id/divider1"
            app:layout_constraintStart_toEndOf="@id/btnAddPlace"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 내가 담은 장소 제목 -->
        <TextView
            android:id="@+id/tvMyPlaceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 내가 담은 장소 (0/5)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/btnAddPlace"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 담은 장소 목록 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMyPlaces"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/tvMyPlaceTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 구분선 2 -->
        <View
            android:id="@+id/divider2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/rvMyPlaces" />

        <!-- 그룹 상태 표시 -->
        <TextView
            android:id="@+id/tvGroupStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 현재 상태: 장소 담기 중"
            android:textSize="14sp"
            android:textColor="#888888"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/divider2"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 일정 생성하기 버튼 (투표 완료 후 활성화) -->
        <Button
            android:id="@+id/btnGenerateSchedule"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="✨ 일정 생성하기"
            android:textSize="16sp"
            android:backgroundTint="#9E9E9E"
            android:enabled="false"
            app:layout_constraintTop_toBottomOf="@id/tvGroupStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>