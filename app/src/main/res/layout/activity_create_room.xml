<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <ImageView
            android:id="@+id/ivRoomProfile"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="20dp"
            android:background="#EEEEEE"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_camera"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPhotoGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="대표 사진 선택"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="@id/ivRoomProfile"
            app:layout_constraintStart_toStartOf="@id/ivRoomProfile"
            app:layout_constraintTop_toBottomOf="@id/ivRoomProfile" />

        <EditText
            android:id="@+id/etRoomName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:hint="여행 이름을 입력하세요 (예: 우정여행)"
            android:inputType="text"
            app:layout_constraintTop_toBottomOf="@id/tvPhotoGuide" />

        <EditText
            android:id="@+id/etCountry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="여행 갈 나라"
            android:inputType="text"
            app:layout_constraintTop_toBottomOf="@id/etRoomName" />

        <EditText
            android:id="@+id/etCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="도시 이름"
            android:inputType="text"
            app:layout_constraintTop_toBottomOf="@id/etCountry" />

        <EditText
            android:id="@+id/etMemberCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="예상 인원 (숫자)"
            android:inputType="number"
            app:layout_constraintTop_toBottomOf="@id/etCity" />

        <Button
            android:id="@+id/btnCreateDone"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="40dp"
            android:text="방 만들기 완료"
            android:backgroundTint="#4CAF50"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/etMemberCount" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>