<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/stampCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface_lowest"
        app:cardCornerRadius="200dp"
        app:cardElevation="2dp"
        app:strokeWidth="2.5dp"
        app:strokeColor="@color/primary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvStampIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✈️"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/tvStampCity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="도쿄"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvStampCountry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="일본"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:gravity="center" />

            <View
                android:layout_width="32dp"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:background="@color/outline_variant" />

            <TextView
                android:id="@+id/tvStampDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2024.03"
                android:textColor="@color/text_hint"
                android:textSize="10sp"
                android:letterSpacing="0.05" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
